+/// Accumulate high-resolution scroll for a scroll binding.
+///
+/// High-resolution wheels send several events per notch, each with part of the 120 units of a
+/// notch, so we accumulate them and only trigger the binding once per full notch. Returns whether
+/// the binding should trigger.
+fn accumulate_scroll(accumulated: &mut f64, v120: f64) -> bool {
+    if accumulated.signum() != v120.signum() {
+        // Changed direction, start over
+        *accumulated = 0.0;
+    }
+    *accumulated += v120;
+    if accumulated.abs() >= 120.0 {
+        *accumulated -= 120.0 * accumulated.signum();
+        true
+    } else {
+        false
+    }
+}
